model_id":"8dc9ccb621c84a9b99d987217cb1a726","version_major":2,"version_minor":0},"text/plain":["judge:   0%|          | 0/80 [00:00<?, ?it/s]"]},"metadata":{},"output_type":"display_data"}],"source":["def score_results(res):\n","    b = bench.set_index(\"qid\"); out = []\n","    for _, r in res.iterrows():\n","        q = b.loc[r.qid].to_dict(); q[\"qid\"] = r.qid\n","        pa = bool(r.pred_answerable) if isinstance(r.pred_answerable, (bool, np.bool_)) else None\n","        s = dict(qid=r.qid, system=r.system, model=r.model, type=q[\"type\"])\n","        s.update(answer_scores(q, r.answer, pa))\n","        s[\"token_f1\"] = token_f1(r.answer, q[\"gold_answer\"])\n","        s.update(retrieval_metrics(json.loads(r.ranked), q[\"gold_evidence\"]))\n","        s[\"citation_validity\"] = citation_validity(json.loads(r.citations), set(json.loads(r.valid_ids)))\n","        if r.system == \"graphrag\":\n","            tp, fp, fn = link_counts(list(json.loads(r.linked)), q[\"gold_entities\"])\n","            s.update(link_tp=tp, link_fp=fp, link_fn=fn, intent_ok=float(json.loads(r.plan)[\"intent\"] == q[\"intent\"]))\n","        out.append(s)\n","    sc = pd.DataFrame(out)\n","    a = embedder.encode(res.answer.fillna(\"\").tolist(), normalize_embeddings=True, batch_size=64)\n","    g = embedder.encode([b.loc[x, \"gold_answer\"] for x in res.qid], normalize_embeddings=True, batch_size=64)\n","    sc[\"sem_sim\"] = (a * g).sum(1)\n","    keep = [\"qid\", \"system\", \"model\", \"answer\", \"ctx_chars\", \"prompt_tokens\", \"output_tokens\", \"retrieval_s\", \"generation_s\", \"n_evidence\", \"evidence\", \"ranked\"]\n","    return sc.merge(res[keep + [c for c in [\"plan\", \"linked\", \"router_s\", \"router_tokens\"] if c in res]], on=[\"qid\", \"system\", \"model\"])\n","\n","JUDGE_SCHEMA = {\"type\": \"object\", \"properties\": {\"correct\": {\"type\": \"boolean\"}, \"reason\": {\"type\": \"string\"}}, \"required\": [\"correct\", \"reason\"]}\n","JUDGE_SYSTEM = \"\"\"You grade an ANSWER against a REFERENCE answer for a question about a disease-symptom dataset.\n","correct=true only if the answer contains ALL the information in the reference and nothing that contradicts it. Harmless extra wording is fine; extra wrong items are not.\n","If the reference says the dataset lacks the information, correct=true only if the answer clearly declines or says the dataset does not contain it.\n","Return JSON: {\"correct\": bool, \"reason\": \"<one short sentence>\"}.\"\"\"\n","FAITH_SCHEMA = {\"type\": \"object\", \"properties\": {\"n_claims\": {\"type\": \"integer\"}, \"n_supported\": {\"type\": \"integer\"}}, \"required\": [\"n_claims\", \"n_supported\"]}\n","FAITH_SYSTEM = \"\"\"You check an ANSWER against numbered EVIDENCE. Count the distinct factual claims in the answer (a refusal has 0 claims) and how many of them are directly supported by the evidence. Return JSON counts only.\"\"\"\n","\n","def judge(sc):\n","    corr, nc, ns = [], [], []\n","    for _, r in tqdm(sc.iterrows(), total=len(sc), desc=\"judge\"):\n","        q = bench.set_index(\"qid\").loc[r.qid]\n","        o, _ = chat_json(CFG[\"JUDGE_MODEL\"], JUDGE_SYSTEM, f\"QUESTION: {q.question}\\nREFERENCE: {q.gold_answer}\\nANSWER: {r.answer}\", JUDGE_SCHEMA, num_predict=120)\n","        corr.append(float(bool(o.get(\"correct\", False))))\n","        ctx, _ = build_context([dict(text=t) for t in json.loads(r.evidence)])\n","        o2, _ = chat_json(CFG[\"JUDGE_MODEL\"], FAITH_SYSTEM, f\"EVIDENCE:\\n{ctx or '(none)'}\\n\\nANSWER: {r.answer}\", FAITH_SCHEMA, num_predict=60)\n","        nc.append(_int(o2.get(\"n_claims\"))); ns.append(min(_int(o2.get(\"n_supported\")), _int(o2.get(\"n_claims\"))))\n","    sc = sc.copy(); sc[\"judge_correct\"] = corr; sc[\"n_claims\"] = nc; sc[\"n_supported\"] = ns\n","    sc[\"faithfulness\"] = np.where(sc.n_claims > 0, sc.n_supported / sc.n_claims.clip(lower=1), np.nan)\n","    return sc\n","\n","full_main = judge(score_results(res_main)); full_main.to_csv(f\"{OUT}/scored_main.csv\", index=False)\n","full_abl = judge(score_results(res_abl)) if res_abl is not None else None\n","if full_abl is not None: full_abl.to_csv(f\"{OUT}/scored_ablation.csv\", index=False)"]},{"cell_type":"markdown","id":"2f4f893b","metadata":{"papermill":{"duration":0.011803,"end_time":"2026-11-23T10:53:51.493752+00:00","exception":false,"start_time":"2026-11-23T10:53:51.481949+00:00","status":"completed"},"tags":[]},"source":["## 11. Results (Task 7): overall, per type, linking, cost"]},{"cell_type":"code","execution_count":26,"id":"2c48febc","metadata":{"execution":{"iopub.execute_input":"2026-11-23T10:53:51.516865Z","iopub.status.busy":"2026-11-23T10:53:51.516592Z","iopub.status.idle":"2026-11-23T10:53:51.692995Z","shell.execute_reply":"2026-11-23T10:53:51.692283Z"},"papermill":{"duration":0.189875,"end_time":"2026-11-23T10:53:51.694502+00:00","exception":false,"start_time":"2026-11-23T10:53:51.504627+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"text/html":["<div>\n","<style scoped>\n","    .dataframe tbody tr th:only-of-type {\n","        vertical-align: middle;\n","    }\n","\n","    .dataframe tbody tr th {\n","        vertical-align: top;\n","    }\n","\n","    .dataframe thead th {\n","        text-align: right;\n","    }\n","</style>\n","<table border=\"1\" class=\"dataframe\">\n","  <thead>\n","    <tr style=\"text-align: right;\">\n","      <th>system</th>\n","      <th>graphrag</th>\n","      <th>vector</th>\n","      <th>vector_hybrid</th>\n","    </tr>\n","  </thead>\n","  <tbody>\n","    <tr>\n","      <th>accuracy</th>\n","      <td>0.600</td>\n","      <td>0.400</td>\n","      <td>0.300</td>\n","    </tr>\n","    <tr>\n","      <th>token_f1</th>\n","      <td>0.348</td>\n","      <td>0.285</td>\n","      <td>0.250</td>\n","    </tr>\n","    <tr>\n","      <th>sem_sim</th>\n","      <td>0.685</td>\n","      <td>0.668</td>\n","      <td>0.635</td>\n","    </tr>\n","    <tr>\n","      <th>judge</th>\n","    