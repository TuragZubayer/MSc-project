},{"data":{"application/vnd.jupyter.widget-view+json":{"model_id":"89c72b46bc0147fd82b4940695c4e7e5","version_major":2,"version_minor":0},"text/plain":["tokenizer_config.json:   0%|          | 0.00/366 [00:00<?, ?B/s]"]},"metadata":{},"output_type":"display_data"},{"data":{"application/vnd.jupyter.widget-view+json":{"model_id":"9cb18e94efe84d9c862c5762f216b55e","version_major":2,"version_minor":0},"text/plain":["vocab.txt:   0%|          | 0.00/232k [00:00<?, ?B/s]"]},"metadata":{},"output_type":"display_data"},{"data":{"application/vnd.jupyter.widget-view+json":{"model_id":"4f42ff49641d44e1ba4b3253ce447bef","version_major":2,"version_minor":0},"text/plain":["tokenizer.json:   0%|          | 0.00/711k [00:00<?, ?B/s]"]},"metadata":{},"output_type":"display_data"},{"data":{"application/vnd.jupyter.widget-view+json":{"model_id":"edfb72167fd74674b84ed60db0b9a844","version_major":2,"version_minor":0},"text/plain":["special_tokens_map.json:   0%|          | 0.00/125 [00:00<?, ?B/s]"]},"metadata":{},"output_type":"display_data"},{"data":{"application/vnd.jupyter.widget-view+json":{"model_id":"ca6fa1de06cb4639ba766f2e3dd9cc35","version_major":2,"version_minor":0},"text/plain":["config.json:   0%|          | 0.00/190 [00:00<?, ?B/s]"]},"metadata":{},"output_type":"display_data"},{"name":"stdout","output_type":"stream","text":["vector index built in 3.8s on cuda; collection size 901\n","['D::panic disorder']\n"]}],"source":["import torch, chromadb\n","from sentence_transformers import SentenceTransformer\n","from rank_bm25 import BM25Okapi\n","\n","\n","# ---- documents (identical facts to the graph; ordering rules mirror the Cypher ORDER BY) ----\n","docs = []\n","for i, d in enumerate(dis_names):\n","    pairs = sorted([(sym_names[j], float(prev.values[i, j])) for j in np.nonzero(A_sym[i])[0]], key=lambda t: (-t[1], t[0]))\n","    txt = fmt_disease(d, int(nrec[d]), pairs)\n","    if MED_ENABLED:\n","        ms = sorted({r[\"medicine\"] for r in med_rows if r[\"disease\"] == d})\n","        if ms: txt += \" Medicines listed for it in a second dataset: \" + \"; \".join(ms) + \".\"\n","    docs.append(dict(id=eid(\"D\", d), text=txt, kind=\"disease\"))\n","nrec_d = nrec.to_dict()\n","for j, s in enumerate(sym_names):\n","    ds = sorted([dis_names[i] for i in np.nonzero(A_sym[:, j])[0]], key=lambda x: (-nrec_d[x], x))\n","    docs.append(dict(id=eid(\"S\", s), text=fmt_symptom(s, len(ds), ds), kind=\"symptom\"))\n","print(len(docs), \"documents; chars min/median/max:\", min(len(d[\"text\"]) for d in docs),\n","      int(np.median([len(d[\"text\"]) for d in docs])), max(len(d[\"text\"]) for d in docs))\n","\n","device = \"cuda\" if torch.cuda.is_available() else \"cpu\"\n","embedder = SentenceTransformer(CFG[\"EMB_MODEL\"], device=device); embedder.max_seq_length = 512\n","QPREFIX = \"Represent this sentence for searching relevant passages: \"\n","\n","t0 = time.perf_counter()\n","doc_emb = embedder.encode([d[\"text\"] for d in docs], batch_size=64, normalize_embeddings=True, show_progress_bar=False)\n","chroma = chromadb.PersistentClient(path=f\"{OUT}/chroma\")\n","try: chroma.delete_collection(\"disease_symptom\")\n","except Exception: pass\n","col = chroma.create_collection(\"disease_symptom\", metadata={\"hnsw:space\": \"cosine\"})\n","for i in range(0, len(docs), 256):\n","    b = docs[i:i + 256]\n","    col.add(ids=[d[\"id\"] for d in b], documents=[d[\"text\"] for d in b], embeddings=doc_emb[i:i + 256].tolist(),\n","            metadatas=[{\"kind\": d[\"kind\"]} for d in b])\n","bm25_tok = lambda t: re.findall(r\"[a-z0-9]+\", t.lower())\n","bm25 = BM25Okapi([bm25_tok(d[\"text\"]) for d in docs])\n","T_VECTOR_BUILD = time.perf_counter() - t0\n","print(f\"vector index built in {T_VECTOR_BUILD:.1f}s on {device}; collection size {col.count()}\")\n","\n","DOC_BY_ID = {d[\"id\"]: d for d in docs}\n","def dense_search(question, k=CFG[\"TOP_K\"]):\n","    qe = embedder.encode([QPREFIX + question], normalize_embeddings=True)[0].tolist()\n","    r = col.query(query_embeddings=[qe], n_results=k)\n","    return [dict(text=t, anchors=[i], score=1 - dist) for i, t, dist in zip(r[\"ids\"][0], r[\"documents\"][0], r[\"distances\"][0])]\n","\n","def hybrid_search(question, k=CFG[\"TOP_K\"], pool=50, rrf_k=60):\n","    dense = dense_search(question, pool)\n","    sc = bm25.get_scores(bm25_tok(question))\n","    sparse = [docs[i][\"id\"] for i in np.argsort(-sc)[:pool]]\n","    fused = defaultdict(float)\n","    for r, e in enumerate(dense): fused[e[\"anchors\"][0]] += 1 / (rrf_k + r + 1)\n","    for r, i in enumerate(sparse): fused[i] += 1 / (rrf_k + r + 1)\n","    top = sorted(fused, key=fused.get, reverse=True)[:k]\n","    return [dict(text=DOC_BY_ID[i][\"text\"], anchors=[i], score=fused[i]) for i in top]\n","print(dense_search(\"Which symptoms are associated with panic disorder?\", 3)[0][\"anchors\"])"]},{"cell_type":"markdown","id":"898c9776","metadata":{"papermill":{"duration":0.006514,"end_time":"2026-11-23T10:13:26.28976+00:00","exception":false,"start_time":"2026-11-23T10:13:26.283246+00:00","status":"completed"},"tags":[]},"source":["## 7. LLM selection and configuration (Task 5)\n","\n","| Choice | Value | Justification (adapt in the report) |\n","|---|---|---|\n","| Generator | `qwen2.5:7b-instruct`, 4-bit (Ollama default Q4_K_M) | best instruction-following + JSON-schema adherence that fits a free Kaggle T4 with room for a 14B judge afterwards |\n","| Ablation | `qwen2.5:3b-instruct` | same family, 2.3× smaller: isolates *model size* |\n","| Judge | `qwen2.5:14b-instruct` | different and larger than the generator (assignment rule); same family ⇒ possible self-preference bias, state it |\n","| Temperature / seed | 0 / 42 | reproducibility (assignment rule) |\n","| Max new tokens | 350 | list answers of ≤ 12 items fit; stops run-away output |\n","| Context window | 8192 | the evidence budget is 6000 chars ≈ 1.5k tokens; 8k leaves a safe margin |\n","| Output | JSON schema `{answerable, answer, citations}` | makes refusals and citations machine-checkable |\n","| Prompt | one shared template for both systems | only retrieval differs (assignment rule) |"]},{"cell_type":"code","execution_count":18,"id":"f6ff4552","metadata":{"execution":{"iopub.execute_input":"2026-11-23T10:13:26.304774Z","iopub.status.busy":"2026-11-23T10:13:26.303748Z","iopub.status.idle":"2026-11-23T10:23:12.29589Z","shell.execute_reply":"2026-11-23T10:23:12.294952Z"},"papermill":{"duration":586.008109,"end_time":"2026-11-23T10:23:12.304379+00:00","exception":false,"start_time":"2026-11-23T10:13:26.29627+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["\u001b[1m\u001b[31mWARNING:\u001b[m systemd is not running\n"," # 100.0%\n",">>> Creating ollama user...\n",">>> Adding ollama user to video group...\n",">>> Adding current user to ollama group...\n",">>> Creating ollama systemd service...\n",">>> NVIDIA GPU installed.\n",">>> The Ollama API is now available at 127.0.0.1:11434.\n",">>> Install complete. Run \"ollama\" from the command line.\n","\n","qwen2.5:7b-instruct -> \u001b[K\n","verifying sha256 digest \u001b[K\n","writing manifest \u001b[K\n","success \u001b[K\u001b[?25h\u001b[?2026l\n","qwen2.5:3b-instruct -> \u001b[K\n","verifying sha256 digest \u001b[K\n","writing manifest \u001b[K\n","success \u001b[K\u001b[?25h\u001b[?2026l\n","qwen2.5:14b-instruct -> \u001b[K\n","verifying sha256 digest \u001b[K\n","writing manifest \u001b[K\n","success \u001b[K\u001b[?25h\u001b[?2026l\n"]}],"source":["import requests, shutil\n","OLLAMA = \"http://localhost:11434\"\n","def sh(cmd): return subprocess.run(cmd, shell=True, capture_output=True, text=True)\n","\n","if not shutil.which(\"ollama\"):\n","    sh(\"apt-get update -qq && apt-get install -y -qq zstd pciutils lshw\")\n","    r = sh(\"curl -fsSL https://ollama.com/install.sh | sh\"); print(r.stdout[-300:], r.stderr[-300:])\n","env = dict(os.environ, OLLAMA_NUM_PARALLEL=\"1\", OLLAMA_KEEP_ALIVE=\"10m\")\n","subprocess.Popen([\"ollama\", \"serve\"], stdout=open(\"/tmp/ollama.log\", \"w\"), stderr=subprocess.STDOUT, env=env)\n","for _ in range(60):\n","    try: requests.get(OLLAMA, timeout=2); break\n","    except Exception: time.sleep(2)\n","for m in [CFG[\"MAIN_MODEL\"], CFG[\"ABL_MODEL\"], CFG[\"JUDGE_MODEL\"]]:\n","    r = sh(f\"ollama pull {m}\"); print(m, \"->\", (r.stdout or r.stderr)[-80:].strip())"]},{"cell_type":"code","execution_count":19,"id":"6f5da5ec","metadata":{"execution":{"iopub.execute_input":"2026-11-23T10:23:12.319819Z","iopub.status.busy":"2026-11-23T10:23:12.319296Z","iopub.status.idle":"2026-11-23T10:23:12.328396Z","shell.execute_reply":"2026-11-23T10:23:12.327629Z"},"papermill":{"duration":0.018529,"end_time":"2026-11-23T10:23:12.329937+00:00","exception":false,"start_time":"2026-11-23T10:23:12.311408+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["def chat_json(model, system, user, schema, num_predict=None, num_ctx=None):\n","    t = time.perf_counter()\n","    payload = dict(model=model, stream=False, format=schema,\n","                   messages=[{\"role\": \"system\", \"content\": system}, {\"role\": \"user\", \"content\": user}],\n","                   options=dict(temperature=CFG[\"TEMPERATURE\"], seed=SEED, num_predict=num_predict or CFG[\"MAX_NEW_TOKENS\"],\n","                                num_ctx=num_ctx or CFG[\"NUM_CTX\"]))\n","    j = requests.post(f\"{OLLAMA}/api/chat\", json=payload, timeout=900).json()\n","    content = j.get(\"message\", {}).get(\"content\", \"\")\n","    try: obj = json.loads(content)\n","    except Exception: obj = {}\n","    return obj, dict(seconds=time.perf_counter() - t, prompt_tokens=j.get(\"prompt_eval_count\", 0), output_tokens=j.get(\"eval_count\", 0))\n","\n","ANSWER_SCHEMA = {\"type\": \"object\", \"properties\": {\n","    \"answerable\": {\"type\": \"boolean\"}, \"answer\": {\"type\": \"string\"}, \"citations\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}}},\n","    \"required\": [\"answerable\", \"answer\", \"citations\"]}\n","\n","SYSTEM_PROMPT = \"\"\"You answer questions about a disease-symptom dataset using ONLY the numbered evidence.\n","Rules:\n","1. If the evidence does not contain the answer, set answerable=false and say the dataset does not contain it. Never guess or use outside knowledge.\n","2. Never give medical advice, diagnoses, medicine names or doses.\n","3. Copy disease and symptom names exactly as written in the evidence.\n","4. Be concise: answer exactly what is asked (a list, a number or a short sentence).\n","5. In citations, list the ids of the evidence items you used, for example [\"E1\",\"E3\"].\"\"\"\n","\n","def build_context(evidence, max_chars=CFG[\"MAX_CTX_CHARS\"]):\n","    lines, ids, used = [], [], 0\n","    for i, e in enumerate(evidence, 1):\n","        line = f\"[E{i}] {e['text']}\"\n","        if used + len(line) > max_chars: break\n","        lines.append(line); ids.append(f\"E{i}\"); used += len(line) + 1\n","    return \"\\n\".join(lines), ids\n","\n","def generate(model, question, evidence):\n","    ctx, ids = build_context(evidence)\n","    user = f\"Evidence:\\n{ctx if ctx else '(no evidence was retrieved)'}\\n\\nQuestion: {question}\\n\\nReturn JSON.\"\n","    obj, meta = chat_json(model, SYSTEM_PROMPT, user, ANSWER_SCHEMA)\n","    return obj, meta, ctx, ids"]},{"cell_type":"markdown","id":"b96eba4b","metadata":{"papermill":{"duration":0.006219,"end_time":"2026-11-23T10:23:12.342521+00:00","exception":false,"start_time":"2026-11-23T10:23:12.336302+00:00","status":"completed"},"tags":[]},"source":["## 8. GraphRAG pipeline (Task 3)\n","\n","**Flow:** question → *router* (one LLM call: intent + the disease/symptom phrases) → **entity linking** (exact dictionary match ∪ router phrases linked by full-text index + fuzzy match, then embedding fall-back) → **parameterised read-only Cypher template** for the intent → evidence lines (one per entity, with anchors) → the shared generator.\n","Questions outside the supported intents fall back to the *neighbourhood* of the linked entities; if nothing links, the evidence is empty and the generator must decline.\n","Text2Cypher is deliberately not used: a 7B model writing free Cypher is a validation risk; templates + a read-only guard keep every query auditable (say this in the report, and mention Text2Cypher as future work)."]},{"cell_type":"code","execution_count":20,"id":"2e6e7493","metadata":{"execution":{"iopub.execute_input":"2026-11-23T10:23:12.357196Z","iopub.status.busy":"2026-11-23T10:23:12.356831Z","iopub.status.idle":"2026-11-23T10:23:12.831888Z","shell.execute_reply":"2026-11-23T10:23:12.831261Z"},"papermill":{"duration":0.484717,"end_time":"2026-11-23T10:23:12.833691+00:00","exception":false,"start_time":"2026-11-23T10:23:12.348974+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["from rapidfuzz import process, fuzz\n","LINK_FUZZ_MIN, LINK_EMB_MIN = 85, 0.78\n","NAME_EMB = {\"D\": embedder.encode(dis_names, normalize_embeddings=True, batch_size=64),\n","            \"S\": embedder.encode(sym_names, normalize_embeddings=True, batch_size=64)}\n","NAMES = {\"D\": dis_names, \"S\": sym_names}\n","\n","def ft_candidates(kind, mention, k=5):\n","    toks = [t for t in re.findall(r\"[a-z0-9]+\", mention.lower()) if len(t) > 1]\n","    if not toks: return []\n","    lq = \" \".join(t + \"~\" if len(t) > 3 else t for t in toks)\n","    idx = \"disease_name_ft\" if kind == \"D\" else \"symptom_name_ft\"\n","    rows = cypher_read(\"CALL db.index.fulltext.queryNodes($idx, $lq) YIELD node, score RETURN node.name AS name, score ORDER BY score DESC LIMIT $k\",\n","                       idx=idx, lq=lq, k=k)\n","    return [r[\"name\"] for r in rows]\n","\n","def link_mention(mention, kind):\n","    m = mention.lower().strip()\n","    if m in (DIS_SET if kind == \"D\" else SYM_SET): return m, \"exact\"\n","    cands = ft_candidates(kind, m)\n","    if cands:\n","        best = process.extractOne(m, cands, scorer=fuzz.token_sort_ratio)\n","        if best and best[1] >= LINK_FUZZ_MIN: return best[0], \"fulltext+fuzzy\"\n","    qv = embedder.encode([m], normalize_embeddings=True)[0]\n","    sims = NAME_EMB[kind] @ qv; i = int(np.argmax(sims))\n","    if sims[i] >= LINK_EMB_MIN: return NAMES[kind][i], \"embedding\"\n","    return None, None\n","\n","def link_entities(question, plan):\n","    found = {}\n","    for e in exact_entities(question):\n","        if e.split(\"::\", 1)[1] not in AMBIG: found[e] = \"exact\"\n","    for kind, key in ((\"D\", \"diseases\"), (\"S\", \"symptoms\")):\n","        for mention in plan.get(key, []):\n","            name, how = link_mention(str(mention), kind)\n","            if name: found.setdefault(eid(kind, name), how)\n","    return found"]},{"cell_type":"code","execution_count":21,"id":"19d9a58b","metadata":{"execution":{"iopub.execute_input":"2026-11-23T10:23:12.848751Z","iopub.status.busy":"2026-11-23T10:23:12.848508Z","iopub.status.idle":"2026-11-23T10:23:12.869734Z","shell.execute_reply":"2026-11-23T10:23:12.868926Z"},"papermill":{"duration":0.030087,"end_time":"2026-11-23T10:23:12.871119+00:00","exception":false,"start_time":"2026-11-23T10:23:12.841032+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["INTENTS = [\"disease_profile\", \"diseases_with_symptoms\", \"symptom_disease_counts\", \"shared_symptoms\", \"similar_diseases\",\n","           \"rank_symptoms\", \"rank_diseases_by_records\", \"count_by_symptom_number\", \"other\"]\n","ROUTER_SCHEMA = {\"type\": \"object\", \"properties\": {\n","    \"intent\": {\"type\": \"string\", \"enum\": INTENTS},\n","    \"diseases\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}}, \"symptoms\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}},\n","    \"top_n\": {\"type\": \"integer\"}, \"k\": {\"type\": \"integer\"}}, \"required\": [\"intent\", \"diseases\", \"symptoms\", \"top_n\", \"k\"]}\n","ROUTER_SYSTEM = \"\"\"You convert a user question about a disease-symptom dataset into a structured query plan. Return JSON only.\n","Intents:\n","- disease_profile: symptoms of ONE disease, how many records it has, or its most frequent symptom.\n","- diseases_with_symptoms: which / how many diseases have ALL of the given symptoms (also: the other symptoms of the disease that has them).\n","- symptom_disease_counts: how many diseases a symptom is associated with, or comparing symptoms by that number.\n","- shared_symptoms: symptoms that two diseases have in common (exactly two diseases).\n","- similar_diseases: diseases that share the most symptoms with one disease.\n","- rank_symptoms: symptoms associated with the largest number of diseases.\n","- rank_diseases_by_records: diseases with the most records.\n","- count_by_symptom_number: how many diseases have exactly k symptoms.\n","- other: anything else (medicines, doses, age, mortality, recovery time, hospitals, unknown diseases ...).\n","Fill 'diseases' and 'symptoms' with the phrases as the user wrote them (everyday wording is fine, do not invent names).\n","top_n = how many ranked items are requested (0 if not a ranking question). k = the number in 'exactly k symptoms' (0 otherwise).\"\"\"\n","\n","def _int(x):\n","    try: return int(x)\n","    except Exception: return 0\n","\n","def route(question, model):\n","    obj, meta = chat_json(model, ROUTER_SYSTEM, question, ROUTER_SCHEMA, num_predict=200)\n","    plan = dict(intent=obj.get(\"intent\") if obj.get(\"intent\") in INTENTS else \"other\",\n","                diseases=[str(x) for x in (obj.get(\"diseases\") or [])][:4], symptoms=[str(x) for x in (obj.get(\"symptoms\") or [])][:4],\n","                top_n=_int(obj.get(\"top_n\")), k=_int(obj.get(\"k\")))\n","    return plan, meta\n","\n","# ---------------- read-only Cypher templates -> evidence items ----------------\n","def ev_profile(d):\n","    rows = cypher_read(\"\"\"MATCH (d:Disease {name: $d})-[r:HAS_SYMPTOM]->(s:Symptom)\n","        WITH d, r, s ORDER BY r.prevalence DESC, s.name\n","        RETURN d.name AS disease, d.n_records AS n, collect([s.name, r.prevalence]) AS syms\"\"\", d=d)\n","    if not rows: return []\n","    r = rows[0]\n","    return [dict(text=fmt_disease(r[\"disease\"], r[\"n\"], [(a, b) for a, b in r[\"syms\"]]), anchors=[eid(\"D\", r[\"disease\"])])]\n","\n","def ev_symptom(s):\n","    rows = cypher_read(\"\"\"MATCH (s:Symptom {name: $s})<-[:HAS_SYMPTOM]-(d:Disease)\n","        WITH s, d ORDER BY d.n_records DESC, d.name\n","        RETURN s.name AS symptom, count(d) AS total, collect(d.name) AS diseases\"\"\", s=s)\n","    if not rows: return []\n","    r = rows[0]\n","    return [dict(text=fmt_symptom(r[\"symptom\"], r[\"total\"], r[\"diseases\"]), anchors=[eid(\"S\", r[\"symptom\"])])]\n","\n","def ev_checker(symptoms, limit=15):\n","    rows = cypher_read(\"\"\"MATCH (d:Disease)-[:HAS_SYMPTOM]->(s:Symptom) WHERE s.name IN $syms\n","        WITH d, count(DISTINCT s) AS m WHERE m = size($syms)\n","        RETURN d.name AS disease, d.n_records AS n, [(d)-[:HAS_SYMPTOM]->(y:Symptom) | y.name] AS all_syms\n","        ORDER BY n DESC, disease\"\"\", syms=symptoms)\n","    items = [dict(text=f\"{len(rows)} disease(s) in the dataset are associated with ALL of these symptoms: {', '.join(symptoms)}.\",\n","                  anchors=[eid(\"S\", s) for s in symptoms])]\n","    for r in rows[:limit]:\n","        items.append(dict(text=f\"Disease: {r['disease']} (records: {r['n']}) is associated with all of {', '.join(symptoms)}. All its symptoms: {'; '.join(r['all_syms'])}.\",\n","                          anchors=[eid(\"D\", r[\"disease\"])]))\n","    return items\n","\n","def ev_shared(a, b):\n","    rows = cypher_read(\"\"\"MATCH (x:Disease {name: $a})-[:HAS_SYMPTOM]->(s:Symptom)<-[:HAS_SYMPTOM]-(y:Disease {name: $b})\n","        RETURN collect(s.name) AS shared\"\"\", a=a, b=b)\n","    sh = rows[0][\"shared\"] if rows else []\n","    txt = (f\"Symptoms shared by {a} and {b}: {'; '.join(sh)}.\" if sh else f\"{a} and {b} have no symptoms in common.\")\n","    return [dict(text=txt, anchors=[eid(\"D\", a), eid(\"D\", b)])]\n","\n","def ev_similar(a, n):\n","    rows = cypher_read(\"\"\"MATCH (x:Disease {name: $a})-[:HAS_SYMPTOM]->(s:Symptom)<-[:HAS_SYMPTOM]-(o:Disease) WHERE o <> x\n","        WITH o, count(s) AS shared, collect(s.name) AS sh ORDER BY shared DESC, o.name ASC LIMIT $n\n","        RETURN o.name AS disease, shared, sh\"\"\", a=a, n=n)\n","    return [dict(text=f\"Disease: {r['disease']} shares {r['shared']} symptoms with {a}: {'; '.join(r['sh'])}.\", anchors=[eid(\"D\", r[\"disease\"])]) for r in rows]\n","\n","def ev_rank_symptoms(n):\n","    rows = cypher_read(\"MATCH (s:Symptom) RETURN s.name AS name, s.n_diseases AS c ORDER BY c DESC, name ASC LIMIT $n\", n=n)\n","    return [dict(text=f\"Rank {i}: symptom '{r['name']}' is associated with {r['c']} diseases.\", anchors=[eid(\"S\", r[\"name\"])]) for i, r in enumerate(rows, 1)]\n","\n","def ev_rank_diseases(n):\n","    rows = cypher_read(\"MATCH (d:Disease) RETURN d.name AS name, d.n_records AS c ORDER BY c DESC, name ASC LIMIT $n\", n=n)\n","    return [dict(text=f\"Rank {i}: disease '{r['name']}' has {r['c']} records.\", anchors=[eid(\"D\", r[\"name\"])]) for i, r in enumerate(rows, 1)]\n","\n","def ev_count_k(k):\n","    r = cypher_read(\"MATCH (d:Disease) WHERE d.n_symptoms = $k RETURN count(d) AS n, collect(d.name)[0..10] AS ex\", k=k)[0]\n","    return [dict(text=f\"{r['n']} diseases have exactly {k} associated symptoms. Examples: {'; '.join(r['ex'])}.\", anchors=[])]\n","\n","def graph_evidence(plan, ents):\n","    intent = plan.get(\"intent\", \"other\")\n","    dis = [e.split(\"::\", 1)[1] for e in ents if e.startswith(\"D::\")]\n","    sym = [e.split(\"::\", 1)[1] for e in ents if e.startswith(\"S::\")]\n","    n = max(1, min(plan.get(\"top_n\") or 5, 10))\n","    ev = []\n","    if intent == \"disease_profile\" and dis: ev = [x for d in dis[:3] for x in ev_profile(d)]\n","    elif intent == \"diseases_with_symptoms\" and sym: ev = ev_checker(sym[:4])\n","    elif intent == \"symptom_disease_counts\" and sym: ev = [x for s in sym[:4] for x in ev_symptom(s)]\n","    elif intent == \"shared_symptoms\" and len(dis) >= 2: ev = ev_shared(dis[0], dis[1])\n","    elif intent == \"similar_diseases\" and dis: ev = ev_profile(dis[0]) + ev_similar(dis[0], n)\n","    elif intent == \"rank_symptoms\": ev = ev_rank_symptoms(n)\n","    elif intent == \"rank_diseases_by_records\": ev = ev_rank_diseases(n)\n","    elif intent == \"count_by_symptom_number\" and plan.get(\"k\"): ev = ev_count_k(int(plan[\"k\"]))\n","    if not ev:                                           # fallback: neighbourhood of whatever was linked\n","        ev = [x for d in dis[:3] for x in ev_profile(d)] + [x for s in sym[:3] for x in ev_symptom(s)]\n","    return ev\n","\n","def graph_retrieve(question, model):\n","    t = time.perf_counter()\n","    plan, rmeta = route(question, model)\n","    ents = link_entities(question, plan)\n","    ev = graph_evidence(plan, ents)\n","    return dict(evidence=ev, plan=plan, entities=ents, router_tokens=rmeta[\"prompt_tokens\"] + rmeta[\"output_tokens\"],\n","                router_seconds=rmeta[\"seconds\"], seconds=time.perf_counter() - t)"]},{"cell_type":"code","execution_count":22,"id":"8c4bf7d4","metadata":{"execution":{"iopub.execute_input":"2026-11-23T10:23:12.885054Z","iopub.status.busy":"2026-11-23T10:23:12.884838Z","iopub.status.idle":"2026-11-23T10:23:17.355498Z","shell.execute_reply":"2026-11-23T10:23:17.354648Z"},"papermill":{"duration":4.480019,"end_time":"2026-11-23T10:23:17.357618+00:00","exception":false,"start_time":"2026-11-23T10:23:12.877599+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["share of answerable questions whose gold items are present in the oracle graph evidence: 1.0\n"]},{"data":{"text/html":["<div>\n","<style scoped>\n","    .dataframe tbody tr th:onl