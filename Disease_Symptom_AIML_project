joint pain\": \"my joints ache\",\n","    \"sore throat\": \"my throat is raw and scratchy\",\n","    \"diarrhea\": \"I have loose watery stools\",\n","    \"skin rash\": \"I have red blotchy skin\",\n","    \"sweating\": \"I am sweating a lot\",\n","    \"chills\": \"I get shivering spells\",\n","    \"sharp abdominal pain\": \"I have a stabbing pain in my belly\",\n","    \"frequent urination\": \"I need to pee all the time\",\n","    \"painful urination\": \"it burns when I pee\",\n","    \"blood in stool\": \"I see blood when I go to the toilet\",\n","    \"insomnia\": \"I cannot fall asleep at night\",\n","    \"palpitations\": \"my heart is racing and fluttering\",\n","    \"nasal congestion\": \"my nose is completely blocked\",\n","    \"ear pain\": \"my ear hurts badly\",\n","    \"leg pain\": \"my legs ache\",\n","    \"back pain\": \"my back hurts\",\n","}\n","UNANSWERABLE = [  # (question, disease named in it or None)\n","    (\"Which medicine should I take for panic disorder?\", \"panic disorder\"),\n","    (\"What is the recommended paracetamol dose for scarlet fever?\", \"scarlet fever\"),\n","    (\"What are the symptoms of COVID-19?\", None),\n","    (\"What is the average age of patients with migraine in this dataset?\", \"migraine\"),\n","    (\"What is the mortality rate of pneumonia according to the dataset?\", \"pneumonia\"),\n","    (\"How many days does recovery from asthma usually take?\", \"asthma\"),\n","    (\"Which hospital recorded the most chickenpox cases?\", \"chickenpox\"),\n","    (\"What are the symptoms of cholera?\", None),\n","]\n","\n","def build_benchmark(seed=SEED):\n","    rng = np.random.default_rng(seed)\n","    D, S = dis_names, sym_names\n","    di = {d: i for i, d in enumerate(D)}; si = {s: j for j, s in enumerate(S)}\n","    Ai = A_sym.astype(np.int32)\n","    deg, nsym = Ai.sum(0), Ai.sum(1)\n","    C = Ai.T @ Ai                       # symptom co-degree\n","    SHd = Ai @ Ai.T                     # shared symptoms between diseases\n","    syms_of = lambda d: [S[j] for j in np.nonzero(Ai[di[d]])[0]]\n","    P = lambda i: prev.values[i]\n","    Q, used = [], set()\n","\n","    def add(typ, sub, question, items, answer, ents, evid, intent, params=None, answerable=True, numeric=False):\n","        Q.append(dict(type=typ, subtype=sub, question=question, gold_items=list(items), gold_answer=answer,\n","                      gold_entities=list(ents), gold_evidence=list(evid), intent=intent,\n","                      params=params or {}, answerable=answerable, numeric=numeric))\n","\n","    def pick(cands, n):\n","        cands = [c for c in cands if c not in used]\n","        out = list(rng.choice(cands, size=n, replace=False))\n","        used.update(out); return out\n","\n","    # ---------------- single-hop (8) ----------------\n","    ph = [\"Which symptoms are associated with {d}?\", \"List the symptoms recorded for {d}.\",\n","          \"What symptoms does {d} present with?\", \"Name the symptoms linked to {d} in the dataset.\"]\n","    for k, d in enumerate(pick([d for d in D if 4 <= nsym[di[d]] <= 6], 4)):\n","        it = syms_of(d)\n","        add(\"single_hop\", \"list_symptoms\", ph[k].format(d=d), it, f\"The symptoms associated with {d} are: {', '.join(it)}.\",\n","            [f\"D::{d}\"], [f\"D::{d}\"], \"disease_profile\")\n","    ph = [\"How many patient records are there for {d}?\", \"How many records of {d} does the dataset contain?\"]\n","    for k, d in enumerate(pick(D, 2)):\n","        n = int(nrec[d])\n","        add(\"single_hop\", \"record_count\", ph[k].format(d=d), [str(n)], f\"There are {n} records for {d}.\",\n","            [f\"D::{d}\"], [f\"D::{d}\"], \"disease_profile\", numeric=True)\n","    ph = [\"What is the most frequently occurring symptom among {d} records?\", \"Which symptom appears most often in patients with {d}?\"]\n","    def margin_ok(d):\n","        v = np.sort(P(di[d])[Ai[di[d]] > 0])[::-1]; return len(v) > 1 and v[0] - v[1] >= 0.05\n","    for k, d in enumerate(pick([d for d in D if margin_ok(d)], 2)):\n","        top = S[int(np.argmax(np.where(Ai[di[d]] > 0, P(di[d]), -1)))]\n","        add(\"single_hop\", \"top_symptom\", ph[k].format(d=d), [top], f\"The most frequent symptom of {d} is {top}.\",\n","            [f\"D::{d}\"], [f\"D::{d}\"], \"disease_profile\")\n","\n","    # ---------------- multi-hop (8) ----------------\n","    ph = [\"Which symptoms do {a} and {b} have in common?\", \"What symptoms are shared between {a} and {b}?\",\n","          \"Name the symptoms that both {a} and {b} are associated with.\"]\n","    done = 0; tries = 0\n","    while done < 3 and tries < 500:\n","        tries += 1\n","        a = D[int(rng.integers(len(D)))]\n","        if a in used or nsym[di[a]] < 5: continue\n","        bs = [D[j] for j in range(len(D)) if D[j] != a and D[j] not in used and 2 <= SHd[di[a], j] <= 4]\n","        if not bs: continue\n","        b = bs[int(rng.integers(len(bs)))]; used.update([a, b])\n","        sh = [s for s in syms_of(a) if s in set(syms_of(b))]\n","        add(\"multi_hop\", \"shared_symptoms\", ph[done].format(a=a, b=b), sh, f\"{a} and {b} share: {', '.join(sh)}.\",\n","            [f\"D::{a}\", f\"D::{b}\"], [f\"D::{a}\", f\"D::{b}\"], \"shared_symptoms\"); done += 1\n","    ph = [\"Which three diseases share the most symptoms with {a}?\", \"What are the three diseases most similar to {a} by shared symptoms?\",\n","          \"Name the 3 diseases with the largest symptom overlap with {a}.\"]\n","    done = 0; tries = 0\n","    while done < 3 and tries < 2000:\n","        tries += 1\n","        a = D[int(rng.integers(len(D)))]\n","        if a in used: continue\n","        row = SHd[di[a]].copy(); row[di[a]] = -1\n","        order = np.argsort(-row, kind=\"stable\"); s3, s4 = row[order[2]], row[order[3]]\n","        if s3 < 3 or s3 <= s4: continue\n","        top3 = [D[j] for j in order[:3]]; used.add(a)\n","        add(\"multi_hop\", \"similar_diseases\", ph[done].format(a=a), top3, f\"The diseases sharing the most symptoms with {a} are: {', '.join(top3)}.\",\n","            [f\"D::{a}\"], [f\"D::{a}\"] + [f\"D::{t}\" for t in top3], \"similar_diseases\", params={\"top_n\": 3}); done += 1\n","    done = 0; tries = 0\n","    while done < 2 and tries < 5000:\n","        tries += 1\n","        d = D[int(rng.integers(len(D)))]\n","        if d in used: continue\n","        ss = syms_of(d)\n","        if len(ss) < 5 or len(ss) > 9: continue\n","        x, y = rng.choice(ss, size=2, replace=False)\n","        if C[si[x], si[y]] != 1: continue\n","        other = [s for s in ss if s not in (x, y)]; used.add(d)\n","        add(\"multi_hop\", \"chain_symptoms_disease_symptoms\",\n","            f\"Consider the one disease that has both {x} and {y}. Which other symptoms is it associated with?\", other,\n","            f\"The disease with both {x} and {y} is {d}; its other symptoms are: {', '.join(other)}.\",\n","            [f\"S::{x}\", f\"S::{y}\"], [f\"D::{d}\"], \"diseases_with_symptoms\"); done += 1\n","\n","    # ---------------- aggregation (8) ----------------\n","    ph = [\"How many diseases in the dataset are associated with {s}?\", \"Count the diseases that list {s} as a symptom.\"]\n","    for k, s in enumerate(pick([s for s in S if 5 <= deg[si[s]] <= 40], 2)):\n","        add(\"aggregation\", \"count_symptom\", ph[k].format(s=s), [str(int(deg[si[s]]))], f\"{int(deg[si[s]])} diseases are associated with {s}.\",\n","            [f\"S::{s}\"], [f\"S::{s}\"], \"symptom_disease_counts\", numeric=True)\n","    tries = 0\n","    while tries < 5000:\n","        tries += 1\n","        x, y = rng.choice(S, size=2, replace=False)\n","        if 2 <= C[si[x], si[y]] <= 10 and x not in used and y not in used: break\n","    used.update([x, y])\n","    add(\"aggregation\", \"count_both\", f\"How many diseases have both {x} and {y}?\", [str(int(C[si[x], si[y]]))],\n","        f\"{int(C[si[x], si[y]])} diseases have both {x} and {y}.\", [f\"S::{x}\", f\"S::{y}\"], [f\"S::{x}\", f\"S::{y}\"],\n","        \"diseases_with_symptoms\", numeric=True)\n","    tries = 0\n","    while tries < 5000:\n","        tries += 1\n","        x, y = rng.choice([s for s in S if deg[si[s]] >= 5 and s not in used], size=2, replace=False)\n","        if abs(int(deg[si[x]]) - int(deg[si[y]])) >= 8: break\n","    win = x if deg[si[x]] > deg[si[y]] else y; used.update([x, y])\n","    add(\"aggregation\", \"compare_symptoms\", f\"Which symptom is associated with more diseases, {x} or {y}?\", [win],\n","        f\"{win} is associated with more diseases ({int(deg[si[win]])} vs {int(min(deg[si[x]], deg[si[y]]))}).\",\n","        [f\"S::{x}\", f\"S::{y}\"], [f\"S::{x}\", f\"S::{y}\"], \"symptom_disease_counts\")\n","    order = np.argsort(-deg, kind=\"stable\"); assert deg[order[0]] > deg[order[1]] and deg[order[2]] > deg[order[3]]\n","    add(\"aggregation\", \"rank_symptoms_top1\", \"Which symptom is associated with the largest number of diseases?\", [S[order[0]]],\n","        f\"{S[order[0]]} ({int(deg[order[0]])} diseases).\", [], [f\"S::{S[order[0]]}\"], \"rank_symptoms\", params={\"top_n\": 1})\n","    top3 = [S[j] for j in order[:3]]\n","    add(\"aggregation\", \"rank_symptoms_top3\", \"Which three symptoms are associated with the most diseases?\", top3,\n","        f\"{', '.join(top3)}.\", [], [f\"S::{t}\" for t in top3], \"rank_symptoms\", params={\"top_n\": 3})\n","    order = np.argsort(-nrec.values, kind=\"stable\"); assert nrec.values[order[0]] > nrec.values[order[1]]\n","    add(\"aggregation\", \"rank_diseases_top1\", \"Which disease has the most records in the dataset?\", [D[order[0]]],\n","        f\"{D[order[0]]} ({int(nrec.values[order[0]])} records).\", [], [f\"D::{D[order[0]]}\"], \"rank_diseases_by_records\", params={\"top_n\": 1})\n","    ks = {k: int((nsym == k).sum()) for k in (9, 10, 11, 12)}\n","    kk = [k for k, v in ks.items() if 5 <= v <= 40][-1]\n","    add(\"aggregation\", \"count_exact_k\", f\"How many diseases have exactly {kk} associated symptoms?\", [str(ks[kk])],\n","        f\"{ks[kk]} diseases have exactly {kk} associated symptoms.\", [], [], \"count_by_symptom_number\", params={\"k\": int(kk)}, numeric=True)\n","\n","    # ---------------- semantic / descriptive (8) ----------------\n","    lay_keys = [k for k in LAY if k in si]\n","    found, tries, seen = 0, 0, set()\n","    while found < 5 and tries < 20000:\n","        tries += 1\n","        r = 3 if found < 3 else 2\n","        combo = [str(x) for x in rng.choice(lay_keys, size=r, replace=False)]\n","        mask = Ai[:, [si[s] for s in combo]].all(axis=1)\n","        ds = [D[i] for i in np.nonzero(mask)[0]]\n","        if not (1 <= len(ds) <= 4) or tuple(ds) in seen: continue\n","        seen.add(tuple(ds))\n","        phrases = [LAY[s] for s in combo]\n","        said = \", \".join(phrases[:-1]) + \" and \" + phrases[-1]\n","        add(\"semantic\", \"lay_patient_statement\",\n","            f\"A person says: \\\"{said}.\\\" Which diseases in the dataset are associated with all of these symptoms?\", ds,\n","            f\"The diseases associated with all of them ({', '.join(combo)}) are: {', '.join(ds)}.\",\n","            [f\"S::{s}\" for s in combo], [f\"D::{d}\" for d in ds], \"diseases_with_symptoms\"); found += 1\n","    ph = [\"In everyday words, what does a person with {d} usually experience?\", \"Describe the typical symptom picture of {d}.\",\n","          \"What would someone suffering from {d} typically complain about?\"]\n","    for k, d in enumerate(pick([d for d in D if 4 <= nsym[di[d]] <= 7], 3)):\n","        it = syms_of(d)\n","        add(\"semantic\", \"profile_description\", ph[k].format(d=d), it, f\"Typical symptoms of {d}: {', '.join(it)}.\",\n","            [f\"D::{d}\"], [f\"D::{d}\"], \"disease_profile\")\n","\n","    # ---------------- unanswerable (8) ----------------\n","    ua = list(UNANSWERABLE)\n","    if CFG[\"MEDICINE_CSV\"]:      # with a medicine layer the first question becomes answerable, so swap it for a dose question\n","        ua[0] = (\"What is the maximum safe daily dose of ibuprofen according to the dataset?\", None)\n","    for q, d in ua:\n","        if d: assert d in di, f\"{d} not in kept diseases\"\n","        add(\"unanswerable\", \"not_in_data\", q, [], \"The dataset does not contain this information.\",\n","            [f\"D::{d}\"] if d else [], [], \"other\", answerable=False)\n","\n","    bench = pd.DataFrame(Q)\n","    bench.insert(0, \"qid\", [f\"Q{i+1:02d}\" for i in range(len(bench))])\n","    return bench\n","\n","bench = build_benchmark()\n","assert bench.type.value_counts().min() >= 4 and len(bench) >= 30 and bench.question.is_unique\n","bench_out = bench.copy()\n","for c in [\"gold_items\", \"gold_entities\", \"gold_evidence\", \"params\"]:\n","    bench_out[c] = bench_out[c].map(json.dumps)\n","bench_out.to_csv(f\"{OUT}/benchmark.csv\", index=False)\n","print(bench.type.value_counts().to_dict())\n","bench[[\"qid\", \"type\", \"subtype\", \"question\", \"gold_items\"]].head(40)"]},{"cell_type":"markdown","id":"c541ae1c","metadata":{"papermill":{"duration":0.005562,"end_time":"2026-11-23T10:12:28.101091+00:00","exception":false,"start_time":"2026-11-23T10:12:28.095529+00:00","status":"completed"},"tags":[]},"source":["## 4. Metrics (Task 6 / Section 4 of the assignment)\n","Retrieval unit = **entity evidence** (`D::<disease>` / `S::<symptom>`). Each retrieved evidence item (a vector chunk or a graph fact line) carries one or more *anchors*; the ranked anchor list (de-duplicated, in order) is what Hit@k / Recall@k / Precision@k / MRR / nDCG@k are computed on, so both systems are scored in the same id space.\n","Precision@k is computed over the anchors actually returned (graph retrieval may return fewer than k).\n","Answer accuracy = *key-item match*: every gold item appears **and** no other disease/symptom name from the vocabulary appears (except the ones named in the question or listed as needed evidence). For unanswerable questions accuracy = correct refusal."]},{"cell_type":"code","execution_count":8,"id":"21a5f077","metadata":{"execution":{"iopub.execute_input":"2026-11-23T10:12:28.112707Z","iopub.status.busy":"2026-11-23T10:12:28.112474Z","iopub.status.idle":"2026-11-23T10:12:28.140835Z","shell.execute_reply":"2026-11-23T10:12:28.140277Z"},"papermill":{"duration":0.035808,"end_time":"2026-11-23T10:12:28.142121+00:00","exception":false,"start_time":"2026-11-23T10:12:28.106313+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["names that are both disease and symptom: ['depression', 'diaper rash', 'drug abuse', 'lymphedema'] (4)\n"]}],"source":["# ---------- entity vocabulary + exact (dictionary) matcher: shared by GraphRAG and by the accuracy metric ----------\n","def eid(kind, name): return f\"{kind}::{name}\"\n","DIS_SET, SYM_SET = set(dis_names), set(sym_names)\n","AMBIG = DIS_SET & SYM_SET                      # names that exist both as disease and symptom\n","ALL_NAMES = sorted(DIS_SET | SYM_SET, key=len, reverse=True)\n","NAME_RE = re.compile(r\"(?<![a-z0-9])(?:\" + \"|\".join(re.escape(n) for n in ALL_NAMES) + r\")(?![a-z0-9])\")\n","print(\"names that are both disease and symptom:\", sorted(AMBIG)[:10], f\"({len(AMBIG)})\")\n","\n","def exact_entities(text):\n","    \"\"\"Longest-first dictionary match on the lower-cased text. Ambiguous names are returned as both kinds (resolved later).\"\"\"\n","    out = []\n","    for m in NAME_RE.finditer(text.lower()):\n","        n = m.group(0)\n","        if n in DIS_SET: out.append(eid(\"D\", n))\n","        if n in SYM_SET: out.append(eid(\"S\", n))\n","    return list(dict.fromkeys(out))\n","\n","def names_in(text):\n","    return {m.group(0) for m in NAME_RE.finditer(text.lower())}"]},{"cell_type":"code","execution_count":9,"id":"b552be03","metadata":{"execution":{"iopub.execute_input":"2026-11-23T10:12:28.153163Z","iopub.status.busy":"2026-11-23T10:12:28.152965Z","iopub.status.idle":"2026-11-23T10:12:28.16933Z","shell.execute_reply":"2026-11-23T10:12:28.168603Z"},"papermill":{"duration":0.023935,"end_time":"2026-11-23T10:12:28.170807+00:00","exception":false,"start_time":"2026-11-23T10:12:28.146872+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["metric self-tests passed\n"]}],"source":["# ---------- answer metrics ----------\n","def norm_answer(s):\n","    s = str(s).lower()\n","    s = re.sub(r\"(?<=\\d),(?=\\d{3})\", \"\", s)          # 1,219 -> 1219\n","    s = re.sub(r\"[^a-z0-9\\s]\", \" \", s)\n","    s = re.sub(r\"\\b(a|an|the)\\b\", \" \", s)\n","    return \" \".join(s.split())\n","\n","def token_f1(pred, gold):                              # SQuAD-style\n","    p, g = norm_answer(pred).split(), norm_answer(gold).split()\n","    if not p or not g: return float(p == g)\n","    ns = sum((Counter(p) & Counter(g)).values())\n","    if ns == 0: return 0.0\n","    pr, rc = ns / len(p), ns / len(g)\n","    return 2 * pr * rc / (pr + rc)\n","\n","def item_present(item, ans):\n","    a, it = norm_answer(ans), norm_answer(item)\n","    return re.search(r\"(?<![a-z0-9])\" + re.escape(it) + r\"(?![a-z0-9])\", a) is not None\n","\n","DECLINE_RE = re.compile(r\"(does not|doesn't|do not|don't|cannot|can't|not) (contain|provide|include|have|mention|specify|say|list|cover|available|found|present)\"\n","                        r\"|no (information|data|evidence)|not (in|part of) the (dataset|data|evidence)|unable to|insufficient|outside (the )?(scope|dataset)\")\n","def is_declined(pred_answerable, answer, q_answerable):\n","    if q_answerable:                                   # strict: only the explicit flag counts as a refusal\n","        return pred_answerable is False\n","    return (pred_answerable is False) or bool(DECLINE_RE.search(str(answer).lower()))\n","\n","def answer_scores(q, answer, pred_answerable):\n","    declined = is_declined(pred_answerable, answer, q[\"answerable\"])\n","    if not q[\"answerable\"]:\n","        return dict(accuracy=float(declined), key_recall=np.nan, n_wrong=np.nan, declined=declined)\n","    items = q[\"gold_items\"]\n","    rec = float(np.mean([item_present(i, answer) for i in items])) if items else 1.0\n","    allowed = set()\n","    for e in list(q[\"gold_entities\"]) + list(q[\"gold_evidence\"]): allowed.add(e.split(\"::\", 1)[1])\n","    allowed |= {norm_answer(i) for i in items} | {i.lower() for i in items}\n","    wrong = 0 if q[\"numeric\"] else len([n for n in names_in(answer) if n not in allowed and norm_answer(n) not in allowed])\n","    acc = float((not declined) and rec == 1.0 and wrong == 0)\n","    return dict(accuracy=acc, key_recall=rec, n_wrong=wrong, declined=declined)\n","\n","# ---------- retrieval metrics ----------\n","def retrieval_metrics(ranked, gold, k=CFG[\"TOP_K\"]):\n","    nan = dict(hit=np.nan, recall=np.nan, precision=np.nan, mrr=np.nan, ndcg=np.nan)\n","    if not gold: return nan\n","    g, topk = set(gold), list(ranked)[:k]\n","    rel = [1 if a in g else 0 for a in topk]\n","    first = next((i + 1 for i, r in enumerate(rel) if r), None)\n","    dcg = sum(r / math.log2(i + 2) for i, r in enumerate(rel))\n","    idcg = sum(1 / math.log2(i + 2) for i in range(min(len(g), k)))\n","    return dict(hit=float(any(rel)), recall=sum(rel) / len(g), precision=(sum(rel) / len(topk)) if topk else 0.0,\n","                mrr=(1 / first) if first else 0.0, ndcg=dcg / idcg)\n","\n","def link_counts(pred, gold):\n","    p, g = set(pred), set(gold)\n","    return len(p & g), len(p - g), len(g - p)          # TP, FP, FN\n","\n","def prf(tp, fp, fn):\n","    P = tp / (tp + fp) if tp + fp else 1.0\n","    R = tp / (tp + fn) if tp + fn else 1.0\n","    return P, R, (2 * P * R / (P + R) if P + R else 0.0)\n","\n","def citation_validity(cited, valid_ids):\n","    cited = [c for c in cited if str(c).strip()]\n","    if not cited: return np.nan\n","    return float(np.mean([c in valid_ids for c in cited]))\n","\n","# quick self-test of the metric code\n","assert abs(token_f1(\"The answer is 905\", \"There are 905 records\") - 0.4) < 0.3\n","assert retrieval_metrics([\"a\", \"b\", \"c\"], [\"b\"], 5)[\"mrr\"] == 0.5 and retrieval_metrics([\"a\"], [], 5)[\"hit\"] != retrieval_metrics([\"a\"], [], 5)[\"hit\"]\n","assert prf(2, 0, 0) == (1.0, 1.0, 1.0)\n","print(\"metric self-tests passed\")"]},{"cell_type":"markdown","id":"4e741926","metadata":{"papermill":{"duration":0.00498,"end_time":"2026-11-23T10:12:28.180648+00:00","exception":false,"start_time":"2026-11-23T10:12:28.175668+00:00","status":"completed"},"tags":[]},"source":["## 5. Neo4j Aura: connect, constraints, indexes, batched load (Task 2)\n","\n","**Graph model** (diagram + tables go in the report):\n","\n","| Node label | Key | Properties | Why it exists |\n","|---|---|---|---|\n","| `Disease` | `name` | `n_records`, `n_symptoms` | the answer entity; `n_records` is the dataset's proxy for how common a disease is |\n","| `Symptom` | `name` | `n_diseases` | what users describe; `n_diseases` makes degree/ranking queries cheap |\n","| `Source` | `doi` | `title`, `publisher`, `licence` | provenance: every disease points to the cited Mendeley record |\n","\n","| Relationship | Direction | Properties | Cardinality | Why it exists |\n","|---|---|---|---|---|\n","| `HAS_SYMPTOM` | Disease → Symptom | `prevalence`, `n_records` | many-to-many | the core fact; `prevalence` = share of the disease's records that show the symptom |\n","| `SIMILAR_TO` | Disease — Disease (stored a→b, query undirected) | `shared`, `jaccard` | many-to-many | derived layer (≥ `SIM_MIN_SHARED` shared symptoms) for \"similar disease\" multi-hop queries |\n","| `FROM_SOURCE` | Disease → Source | – | many-to-one | provenance / citation of the original record |\n","| `TREATS` *(optional 2nd dataset)* | Medicine → Disease | – | many-to-many | medicine suggestion layer, only if `MEDICINE_CSV` is given |"]},{"cell_type":"code","execution_count":10,"id":"41e716b5","metadata":{"execution":{"iopub.execute_input":"2026-11-23T10:12:28.19153Z","iopub.status.busy":"2026-11-23T10:12:28.191154Z","iopub.status.idle":"2026-11-23T10:12:29.23214Z","shell.execute_reply":"2026-11-23T10:12:29.231281Z"},"papermill":{"duration":1.048468,"end_time":"2026-11-23T10:12:29.233848+00:00","exception":false,"start_time":"2026-11-23T10:12:28.18538+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["NEO4J_URI: found (length=37)\n","NEO4J_USERNAME: found (length=8)\n","NEO4J_PASSWORD: found (length=43)\n","NEO4J_DATABASE: found (length=8)\n"]}],"source":["from kaggle_secrets import UserSecretsClient\n","\n","client = UserSecretsClient()\n","for key in [\"NEO4J_URI\", \"NEO4J_USERNAME\", \"NEO4J_PASSWORD\", \"NEO4J_DATABASE\"]:\n","    try:\n","        val = client.get_secret(key)\n","        print(f\"{key}: found (length={len(str(val))})\")\n","    except Exception as e:\n","        print(f\"{key}: NOT found -> {type(e).__name__}: {e}\")"]},{"cell_type":"code","execution_count":11,"id":"b90e08d1","metadata":{"execution":{"iopub.execute_input":"2026-11-23T10:12:29.245827Z","iopub.status.busy":"2026-11-23T10:12:29.24556Z","iopub.status.idle":"2026-11-23T10:12:30.913501Z","shell.execute_reply":"2026-11-23T10:12:30.912639Z"},"papermill":{"duration":1.67569,"end_time":"2026-11-23T10:12:30.915093+00:00","exception":false,"start_time":"2026-11-23T10:12:29.239403+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["connected to Aura, database: d898fdf4\n"]}],"source":["import os\n","from neo4j import GraphDatabase, RoutingControl\n","\n","NEO4J_URI = (get_secret(\"NEO4J_URI\") or os.getenv(\"NEO4J_URI\", \"\")).strip()\n","NEO4J_USER = (get_secret(\"NEO4J_USERNAME\") or os.getenv(\"NEO4J_USERNAME\", \"\")).strip()\n","NEO4J_PASS = (get_secret(\"NEO4J_PASSWORD\") or os.getenv(\"NEO4J_PASSWORD\", \"\")).strip()\n","NEO4J_DB = ((get_secret(\"NEO4J_DATABASE\", \"neo4j\") or \"neo4j\")).strip()\n","\n","assert NEO4J_URI, \"NEO4J_URI is not found \"\n","assert NEO4J_URI.startswith((\"neo4j://\", \"neo4j+s://\", \"neo4j+ssc://\", \"bolt://\", \"bolt+s://\", \"bolt+ssc://\")), (\n","    f\"wrong NEO4J_URI format: {NEO4J_URI!r}\"\n",")\n","\n","driver = GraphDatabase.driver(NEO4J_URI, auth=(NEO4J_USER, NEO4J_PASS))\n","driver.verify_connectivity()\n","print(\"connected to Aura, database:\", NEO4J_DB)"]},{"cell_type":"code","execution_count":12,"id":"6ff6c731","metadata":{"execution":{"iopub.execute_input":"2026-11-23T10:12:30.927897Z","iopub.status.busy":"2026-11-23T10:12:30.927063Z","iopub.status.idle":"2026-11-23T10:12:32.499641Z","shell.execute_reply":"2026-11-23T10:12:32.4988Z"},"papermill":{"duration":1.580324,"end_time":"2026-11-23T10:12:32.501195+00:00","exception":false,"start_time":"2026-11-23T10:12:30.920871+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["connected to Aura, database: d898fdf4\n"]}],"source":["from neo4j import GraphDatabase, RoutingControl\n","\n","NEO4J_DB = get_secret(\"NEO4J_DATABASE\", \"neo4j\") or \"neo4j\"\n","driver = GraphDatabase.driver(get_secret(\"NEO4J_URI\"), auth=(get_secret(\"NEO4J_USERNAME\"), get_secret(\"NEO4J_PASSWORD\")))\n","driver.verify_connectivity()\n","print(\"connected to Aura, database:\", NEO4J_DB)\n","\n","_WRITE_RE = re.compile(r\"\\b(create|merge|delete|detach|set|remove|drop|foreach|load\\s+csv)\\b\", re.I)\n","def assert_read_only(q):\n","    \"\"\"Defence in depth: every query issued by the RAG pipeline goes through here.\"\"\"\n","    if _WRITE_RE.search(q): raise ValueError(\"write clause found in a read-only query\")\n","    for m in re.finditer(r\"\\bcall\\s+([\\w.]+)\", q, re.I):\n","        if m.group(1).lower() != \"db.index.fulltext.querynodes\": raise ValueError(f\"CALL {m.group(1)} not allowed\")\n","\n","def cypher_read(query, /, **params):\n","    assert_read_only(query)\n","    recs, _, _ = driver.execute_query(query, parameters_=params, database_=NEO4J_DB, routing_=RoutingControl.READ)\n","    return [r.data() for r in recs]\n","\n","def cypher_write(query, /, **params):                # used only by the loader cells\n","    driver.execute_query(query, parameters_=params, database_=NEO4J_DB)\n","\n","def write_batches(q, rows, size=1000):\n","    with driver.session(database=NEO4J_DB) as s:\n","        for i in range(0, len(rows), size):\n","            chunk = rows[i:i + size]\n","            s.execute_write(lambda tx: tx.run(q, rows=chunk).consume())"]},{"cell_type":"code","execution_count":13,"id":"243b70d5","metadata":{"execution":{"iopub.execute_input":"2026-11-23T10:12:32.512938Z","iopub.status.busy":"2026-11-23T10:12:32.512636Z","iopub.status.idle":"2026-11-23T10:12:36.911576Z","shell.execute_reply":"2026-11-23T10:12:36.910773Z"},"papermill":{"duration":4.406391,"end_time":"2026-11-23T10:12:36.913045+00:00","exception":false,"start_time":"2026-11-23T10:12:32.506654+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["graph built + loaded in 5.2s\n"]}],"source":["RESET_GRAPH = False        # True = delete everything in this Aura database first (careful!)\n","t0 = time.perf_counter()\n","if RESET_GRAPH: cypher_write(\"MATCH (n) DETACH DELETE n\")\n","\n","for q in [\n","    \"CREATE CONSTRAINT disease_name IF NOT EXISTS FOR (d:Disease) REQUIRE d.name IS UNIQUE\",\n","    \"CREATE CONSTRAINT symptom_name IF NOT EXISTS FOR (s:Symptom) REQUIRE s.name IS UNIQUE\",\n","    \"CREATE CONSTRAINT source_doi   IF NOT EXISTS FOR (s:Source)  REQUIRE s.doi  IS UNIQUE\",\n","    \"CREATE FULLTEXT INDEX disease_name_ft IF NOT EXISTS FOR (n:Disease) ON EACH [n.name]\",\n","    \"CREATE FULLTEXT INDEX symptom_name_ft IF NOT EXISTS FOR (n:Symptom) ON EACH [n.name]\",\n","]: cypher_write(q)\n","\n","write_batches(\"UNWIND $rows AS r MERGE (d:Disease {name: r.name}) SET d.n_records = r.n_records, d.n_symptoms = r.n_symptoms\", disease_rows)\n","write_batches(\"UNWIND $rows AS r MERGE (s:Symptom {name: r.name}) SET s.n_diseases = r.n_diseases\", symptom_rows)\n","write_batches(\"\"\"UNWIND $rows AS r\n","  MATCH (d:Disease {name: r.disease}) MATCH (s:Symptom {name: r.symptom})\n","  MERGE (d)-[x:HAS_SYMPTOM]->(s) SET x.prevalence = r.prevalence, x.n_records = r.n_records\"\"\", has_rows)\n","write_batches(\"\"\"UNWIND $rows AS r\n","  MATCH (a:Disease {name: r.a}) MATCH (b:Disease {name: r.b})\n","  MERGE (a)-[x:SIMILAR_TO]->(b) SET x.shared = r.shared, x.jaccard = r.jaccard\"\"\", sim_rows)\n","cypher_write(\"\"\"MERGE (src:Source {doi: $doi}) SET src.title = $title, src.publisher = $pub, src.licence = $lic\n","  WITH src MATCH (d:Disease) MERGE (d)-[:FROM_SOURCE]->(src)\"\"\",\n","  doi=CFG[\"DATASET_DOI\"], title=CFG[\"DATASET_TITLE\"], pub=CFG[\"DATASET_SOURCE\"], lic=CFG[\"DATASET_LICENCE\"])\n","cypher_write(\"CALL db.awaitIndexes(300)\")\n","T_GRAPH_LOAD = time.perf_counter() - t0 + T_BUILD_TABLES\n","print(f\"graph built + loaded in {T_GRAPH_LOAD:.1f}s\")"]},{"cell_type":"markdown","id":"91e5c7f4","metadata":{"papermill":{"duration":0.005144,"end_time":"2026-11-23T10:12:36.923649+00:00","exception":false,"start_time":"2026-11-23T10:12:36.918505+00:00","status":"completed"},"tags":[]},"source":["# Optional medicine layer"]},{"cell_type":"code","execution_count":14,"id":"af2d1150","metadata":{"execution":{"iopub.execute_input":"2026-11-23T10:12:36.935039Z","iopub.status.busy":"2026-11-23T10:12:36.934702Z","iopub.status.idle":"2026-11-23T10:12:36.941481Z","shell.execute_reply":"2026-11-23T10:12:36.940739Z"},"papermill":{"duration":0.01422,"end_time":"2026-11-23T10:12:36.943042+00:00","exception":false,"start_time":"2026-11-23T10:12:36.928822+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["No medicine layer: medicine / dose questions are intentionally UNANSWERABLE for both systems.\n"]}],"source":["MED_ENABLED = False\n","if CFG[\"MEDICINE_CSV\"]:\n","    from rapidfuzz import process, fuzz\n","    med = pd.read_csv(CFG[\"MEDICINE_CSV\"])                      # must have columns: disease, medicine\n","    med[\"disease\"] = med[\"disease\"].astype(str).str.strip().str.lower()\n","    med[\"medicine\"] = med[\"medicine\"].astype(str).str.strip().str.lower()\n","    def match_disease(x):\n","        if x in DIS_SET: return x\n","        hit = process.extractOne(x, dis_names, scorer=fuzz.token_sort_ratio)\n","        return hit[0] if hit and hit[1] >= 92 else None\n","    med[\"matched\"] = med[\"disease\"].map(match_disease)\n","    print(f\"disease name match rate: {med.matched.notna().mean():.1%}  (report this + the unmatched examples)\")\n","    med_rows = med.dropna(subset=[\"matched\"])[[\"matched\", \"medicine\"]].drop_duplicates().rename(columns={\"matched\": \"disease\"}).to_dict(\"records\")\n","    cypher_write(\"CREATE CONSTRAINT medicine_name IF NOT EXISTS FOR (m:Medicine) REQUIRE m.name IS UNIQUE\")\n","    write_batches(\"\"\"UNWIND $rows AS r MATCH (d:Disease {name: r.disease})\n","      MERGE (m:Medicine {name: r.medicine}) MERGE (m)-[:TREATS]->(d)\"\"\", med_rows)\n","    MED_ENABLED = True\n","else:\n","    print(\"No medicine layer: medicine / dose questions are intentionally UNANSWERABLE for both systems.\")"]},{"cell_type":"markdown","id":"ddf793d3","metadata":{"papermill":{"duration":0.005762,"end_time":"2026-11-23T10:12:36.954356+00:00","exception":false,"start_time":"2026-11-23T10:12:36.948594+00:00","status":"completed"},"tags":[]},"source":["### 5c. Validate the load and show exploratory Cypher (Task 2)"]},{"cell_type":"code","execution_count":15,"id":"97b206f9","metadata":{"execution":{"iopub.execute_input":"2026-11-23T10:12:36.966749Z","iopub.status.busy":"2026-11-23T10:12:36.966543Z","iopub.status.idle":"2026-11-23T10:12:38.093048Z","shell.execute_reply":"2026-11-23T10:12:38.092284Z"},"papermill":{"duration":1.134721,"end_time":"2026-11-23