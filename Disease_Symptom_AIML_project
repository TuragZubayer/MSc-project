n","rel_got = {r[\"t\"]: r[\"n\"] for r in cypher_read(\"MATCH ()-[r]->() WHERE type(r) <> 'TREATS' RETURN type(r) AS t, count(*) AS n\")}\n","print(\"rel counts    expected\", rel_exp, \"| in Aura\", rel_got)\n","assert exp == got and rel_exp == rel_got, \"graph does not match the source aggregation\"\n","bad = cypher_read(\"MATCH (s:Symptom) OPTIONAL MATCH (s)<-[r:HAS_SYMPTOM]-() WITH s, count(r) AS c WHERE c <> s.n_diseases RETURN count(s) AS bad\")[0][\"bad\"]\n","assert bad == 0\n","samp = random.Random(SEED).sample(has_rows, 25)\n","chk = cypher_read(\"UNWIND $rows AS r MATCH (:Disease {name:r.disease})-[x:HAS_SYMPTOM]->(:Symptom {name:r.symptom}) RETURN r.prevalence AS exp, x.prevalence AS got\", rows=samp)\n","assert len(chk) == 25 and all(abs(c[\"exp\"] - c[\"got\"]) < 1e-9 for c in chk)\n","print(\"validation passed: counts match, degrees consistent, 25 sampled edges have identical prevalence\")"]},{"cell_type":"markdown","id":"956ae9bb","metadata":{"papermill":{"duration":0.005712,"end_time":"2026-11-23T10:12:38.107117+00:00","exception":false,"start_time":"2026-11-23T10:12:38.101405+00:00","status":"completed"},"tags":[]},"source":["## 6. Vector RAG pipeline (Task 4)\n","\n","* **Serialisation (no free text exists):** one chunk per entity, built from the *same aggregated facts* the graph holds.\n","  `Disease:` chunks list all symptoms with prevalence; `Symptom:` chunks give the number of associated diseases and up to 40 of them (most records first).\n","  A chunk is never split: each is < 512 tokens, so one chunk = one entity = one retrieval unit.\n","* **Embedding:** `BAAI/bge-small-en-v1.5` (384-d, CPU-friendly, strong on short retrieval); queries use the BGE query prefix.\n","* **Store / metric / k:** ChromaDB (as in the lab, persistent, HNSW) with **cosine** similarity, **top-k = 5**.\n","* **Optional (evaluated as a third system):** hybrid BM25 + dense with Reciprocal Rank Fusion."]},{"cell_type":"code","execution_count":16,"id":"d5336040","metadata":{"execution":{"iopub.execute_input":"2026-11-23T10:12:38.120752Z","iopub.status.busy":"2026-11-23T10:12:38.119998Z","iopub.status.idle":"2026-11-23T10:12:38.124901Z","shell.execute_reply":"2026-11-23T10:12:38.124282Z"},"papermill":{"duration":0.013155,"end_time":"2026-11-23T10:12:38.126463+00:00","exception":false,"start_time":"2026-11-23T10:12:38.113308+00:00","status":"completed"},"tags":[]},"outputs":[],"source":[" #---------- one text format for an entity, used by BOTH systems (same facts, same wording) ----------\n","SYMPTOM_DOC_MAX = 40\n","def fmt_disease(name, n_records, sym_pairs):\n","    return (f\"Disease: {name}. Records in dataset: {n_records}. Associated symptoms (prevalence among its records): \"\n","            + \"; \".join(f\"{s} ({p:.2f})\" for s, p in sym_pairs) + \".\")\n","def fmt_symptom(name, total, dis_list):\n","    shown = dis_list[:SYMPTOM_DOC_MAX]\n","    tail = f\" (showing {len(shown)} of {total}, most records first)\" if total > len(shown) else \"\"\n","    return f\"Symptom: {name}. Associated with {total} diseases in the dataset{tail}: \" + \"; \".join(shown) + \".\""]},{"cell_type":"code","execution_count":17,"id":"46cb5525","metadata":{"execution":{"iopub.execute_input":"2026-11-23T10:12:38.139067Z","iopub.status.busy":"2026-11-23T10:12:38.1387Z","iopub.status.idle":"2026-11-23T10:13:26.274352Z","shell.execute_reply":"2026-11-23T10:13:26.273412Z"},"papermill":{"duration":48.144028,"end_time":"2026-11-23T10:13:26.275982+00:00","exception":false,"start_time":"2026-11-23T10:12:38.131954+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["901 documents; chars min/median/max: 72 292 975\n"]},{"data":{"application/vnd.jupyter.widget-view+json":{"model_id":"6972e99d264b488aa246791d75c545ba","version_major":2,"version_minor":0},"text/plain":["modules.json:   0%|          | 0.00/349 [00:00<?, ?B/s]"]},"metadata":{},"output_type":"display_data"},{"name":"stderr","output_type":"stream","tex