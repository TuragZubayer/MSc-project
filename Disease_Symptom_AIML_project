\n","    return ev, time.perf_counter() - t, info\n","\n","def run_one(system, q, model):\n","    ev, t_ret, info = retrieve(system, q.question, model)\n","    obj, meta, ctx, ids = generate(model, q.question, ev)\n","    ranked = list(dict.fromkeys(a for e in ev for a in e[\"anchors\"]))\n","    return dict(qid=q.qid, system=system, model=model, answer=str(obj.get(\"answer\", \"\")), pred_answerable=obj.get(\"answerable\", None),\n","                citations=json.dumps(obj.get(\"citations\", [])), valid_ids=json.dumps(ids), ctx_chars=len(ctx),\n","                prompt_tokens=meta[\"prompt_tokens\"], output_tokens=meta[\"output_tokens\"], retrieval_s=t_ret, generation_s=meta[\"seconds\"],\n","                n_evidence=len(ev), ranked=json.dumps(ranked), evidence=json.dumps([e[\"text\"] for e in ev]), **info)\n","\n","def run_benchmark(model, systems):\n","    rows = []\n","    for _, q in tqdm(list(bench.iterrows()), desc=model):\n","        for s in systems: rows.append(run_one(s, q, model))\n","    return pd.DataFrame(rows)\n","\n","t0 = time.perf_counter()\n","res_main = run_benchmark(CFG[\"MAIN_MODEL\"], SYSTEMS)\n","res_main.to_csv(f\"{OUT}/raw_results_main.csv\", index=False)\n","print(f\"main run: {time.perf_counter()-t0:.0f}s for {len(res_main)} answers\")"]},{"cell_type":"code","execution_count":24,"id":"3a6f9a68","metadata":{"execution":{"iopub.execute_input":"2026-11-23T10:29:37.395658Z","iopub.status.busy":"2026-11-23T10:29:37.395389Z","iopub.status.idle":"2026-11-23T10:32:13.052418Z","shell.execute_reply":"2026-11-23T10:32:13.051698Z"},"papermill":{"duration":155.66841,"end_time":"2026-11-23T10:32:13.05469+00:00","exception":false,"start_time":"2026-11-23T10:29:37.38628+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"application/vnd.jupyter.widget-view+json":{"model_id":"5efa561bc1794df39b4e3d355f801563","version_major":2,"version_minor":0},"text/plain":["qwen2.5:3b-instruct:   0%|          | 0/40 [00:00<?, ?it/s]"]},"metadata":{},"outp