 2nd dataset: CSV with columns disease,medicine (see section 3b)\n",")\n","OUT = \"/kaggle/working\" if os.path.isdir(\"/kaggle/working\") else os.path.abspath(\"./out\")\n","os.makedirs(OUT, exist_ok=True)\n","\n","def get_secret(name, default=None):\n","    \"\"\"Kaggle Secrets first, environment variable as fallback. Never hard-code credentials.\"\"\"\n","    try:\n","        from kaggle_secrets import UserSecretsClient\n","        return UserSecretsClient().get_secret(name)\n","    except Exception:\n","        return os.environ.get(name, default)\n","print(\"output dir:\", OUT)"]},{"cell_type":"markdown","id":"d83a2d59","metadata":{"papermill":{"duration":0.004159,"end_time":"2026-11-23T10:12:18.910414+00:00","exception":false,"start_time":"2026-11-23T10:12:18.906255+00:00","status":"completed"},"tags":[]},"source":["## 1. Data card and exploratory analysis (Task 1)"]},{"cell_type":"code","execution_count":4,"id":"939dca08","metadata":{"execution":{"iopub.execute_input":"2026-11-23T10:12:18.920434Z","iopub.status.busy":"2026-11-23T10:12:18.919952Z","iopub.status.idle":"2026-11-23T10:12:23.538176Z","shell.execute_reply":"2026-11-23T10:12:23.537272Z"},"papermill":{"duration":4.625284,"end_time":"2026-11-23T10:12:23.539905+00:00","exception":false,"start_time":"2026-11-23T10:12:18.914621+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["reading /kaggle/input/datasets/turagzubayer/disease/Disease and symptoms dataset.csv\n","(246945, 378)\n"]}],"source":["def find_csv():\n","    pats = [\"/kaggle/input/datasets/turagzubayer/disease/Disease and symptoms dataset.csv\"]\n","    for p in pats:\n","        hits = glob.glob(p, recursive=True)\n","        if hits: return hits[0]\n","    raise FileNotFoundError(\"Attach the Mendeley CSV as a Kaggle input.\")\n","\n","CSV = find_csv(); print(\"reading\", CSV)\n","hdr = pd.read_csv(CSV, nrows=0).columns.tolist()\n","DIS_COL, SYMS = hdr[0], hdr[1:]\n","raw = pd.read_csv(CSV, dtype={c: \"int8\" for c in SYMS})\n","raw[DIS_COL] = raw[DIS_COL].astype(str).str.strip().str.lower()\n","print(raw.shape)"]},{"cell_type":"code","execution_count":5,"id":"117388de","metadata":{"execution":{"iopub.execute_input":"2026-11-23T10:12:23.550092Z","iopub.status.busy":"2026-11-23T10:12:23.549746Z","iopub.status.idle":"2026-11-23T10:12:27.01041Z","shell.execute_reply":"2026-11-23T10:12:27.009605Z"},"papermill":{"duration":3.467678,"end_time":"2026-11-23T10:12:27.011948+00:00","exception":false,"start_time":"2026-11-23T10:12:23.54427+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["source / DOI                               Mendeley Data (contributor: Bran Stark; published 3 Mar 2025; version 1) | doi:10.17632/2cxccsxydc.1\n","licence                                    << copy the licence shown on the Mendeley record page >>\n","rows (patient records)                     246945\n","diseases                                   773\n","symptom columns                            377\n","missing cells                              0\n","non-binary symptom cells                   0\n","records with 0 symptoms                    0\n","exact duplicate rows                       57298\n","symptom columns never = 1                  49\n","diseases with < MIN_RECORDS records        191\n","records per disease (median / max)         168 / 1219\n","symptoms per record (mean / max)           5.33 / 12\n"]},{"data":{"image/png":"\n","text/plain":["<Figure size 1500x360 with 3 Axes>"]},"metadata":{},"output_type":"display_data"}],"source":["import matplotlib\n","matplotlib.use(\"Agg\") if not os.environ.get(\"KAGGLE_KERNEL_RUN_TYPE\") else None\n","import matplotlib.pyplot as plt\n","\n","X = raw[SYMS]\n","n_per_disease = raw.groupby(DIS_COL).size()\n","syms_per_record = X.sum(axis=1)\n","\n","card = {\n","    \"source / DOI\": f\"{CFG['DATASET_SOURCE']} | doi:{CFG['DATASET_DOI']}\",\n","    \"licence\": CFG[\"DATASET_LICENCE\"],\n","    \"rows (patient records)\": len(raw),\n","    \"diseases\": raw[DIS_COL].nunique(),\n","    \"symptom columns\": len(SYMS),\n","    \"missing cells\": int(raw.isna().sum().sum()),\n","    \"non-binary symptom cells\": int((~X.isin([0, 1])).sum().sum()),\n","    \"records with 0 symptoms\": int((syms_per_record == 0).sum()),\n","    \"exact duplicate rows\": int(raw.duplicated().sum()),\n","    \"symptom columns never = 1\": int((X.sum() == 0).sum()),\n","    \"diseases with < MIN_RECORDS records\": int((n_per_disease < CFG[\"MIN_RECORDS\"]).sum()),\n","    \"records per disease (median / max)\": f\"{int(n_per_disease.median())} / {int(n_per_disease.max())}\",\n","    \"symptoms per record (mean / max)\": f\"{syms_per_record.mean():.2f} / {int(syms_per_record.max())}\",\n","}\n","for k, v in card.items(): print(f\"{k:42s} {v}\")\n","\n","fig, ax = plt.subplots(1, 3, figsize=(15, 3.6))\n","ax[0].hist(syms_per_record, bins=range(0, 14)); ax[0].set_title(\"symptoms per record\")\n","ax[1].hist(n_per_disease, bins=40); ax[1].set_yscale(\"log\"); ax[1].set_title(\"records per disease (log y)\")\n","ax[2].hist(X.sum().values, bins=40); ax[2].set_title(\"records per symptom\")\n","plt.tight_layout(); plt.savefig(f\"{OUT}/eda.png\", dpi=130); plt.show()"]},{"cell_type":"markdown","id":"63932890","metadata":{"papermill":{"duration":0.004826,"end_time":"2026-11-23T10:12:27.021588+00:00","exception":false,"start_time":"2026-11-23T10:12:27.016762+00:00","status":"completed"},"tags":[]},"source":["What the EDA tells us (write this in the report): the table is a patient-level binary matrix, but it is artificially generated, so each disease has a small fixed symptom set (about 4–12 symptoms) and records are random subsets of it. The informative structure is therefore the disease ↔ symptom bipartite graph plus the record counts (the dataset description says more records = more common disease). Many diseases have very few records, so we drop diseases below MIN_RECORDS and report how much data that removes."]},{"cell_type":"markdown","id":"19d7b5a4","metadata":{"papermill":{"duration":0.004457,"end_time":"2026-11-23T10:12:27.030543+00:00","exception":false,"start_time":"2026-11-23T10:12:27.026086+00:00","status":"completed"},"tags":[]},"source":["## 2. Graph tables: nodes, relationships and derived layers (Task 2)"]},{"cell_type":"code","execution_count":6,"id":"6ac90caf","metadata":{"execution":{"iopub.execute_input":"2026-11-23T10:12:27.041331Z","iopub.status.busy":"2026-11-23T10:12:27.04072Z","iopub.status.idle":"2026-11-23T10:12:27.812329Z","shell.execute_reply":"2026-11-23T10:12:27.811382Z"},"papermill":{"duration":0.779092,"end_time":"2026-11-23T10:12:27.814108+00:00","exception":false,"start_time":"2026-11-23T10:12:27.035016+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["kept 582 / 773 diseases, 244,938 / 246,945 records (99.2%) after MIN_RECORDS=30\n","Disease nodes 582 | Symptom nodes 319 | HAS_SYMPTOM 4756 | SIMILAR_TO 9563\n","symptoms per disease: {'min': 4.0, '50%': 8.0, 'max': 12.0}\n","prevalence range of existing edges: 0.353 - 1.0\n"]}],"source":["t_build0 = time.perf_counter()\n","keep = n_per_disease[n_per_disease >= CFG[\"MIN_RECORDS\"]].index\n","df = raw[raw[DIS_COL].isin(keep)]\n","print(f\"kept {len(keep)} / {len(n_per_disease)} diseases, {len(df):,} / {len(raw):,} records \"\n","      f\"({len(df)/len(raw):.1%}) after MIN_RECORDS={CFG['MIN_RECORDS']}\")\n","\n","dis_names = sorted(keep)\n","cnt  = df.groupby(DIS_COL)[SYMS].sum().loc[dis_names]          # records of disease d that have symptom s\n","nrec = df.groupby(DIS_COL).size().loc[dis_names]\n","sym_names = [s for s in SYMS if cnt[s].sum() > 0]               # symptoms that occur in at least one kept disease\n","cnt = cnt[sym_names]\n","prev = cnt.div(nrec, axis=0)\n","A_sym = (cnt.values > 0)                                       # disease x symptom incidence\n","\n","# --- node tables\n","disease_rows = [dict(name=d, n_records=int(nrec[d]), n_symptoms=int(A_sym[i].sum())) for i, d in enumerate(dis_names)]\n","symptom_rows = [dict(name=s, n_diseases=int(A_sym[:, j].sum())) for j, s in enumerate(sym_names)]\n","# --- HAS_SYMPTOM: one edge per (disease, symptom) that occurs; prevalence = share of the disease's records having it\n","ii, jj = np.nonzero(A_sym)\n","has_rows = [dict(disease=dis_names[i], symptom=sym_names[j], n_records=int(cnt.values[i, j]),\n","                 prevalence=round(float(prev.values[i, j]), 4)) for i, j in zip(ii, jj)]\n","# --- SIMILAR_TO: derived disease-disease layer (shared symptoms, Jaccard)\n","Ai = A_sym.astype(np.int32)\n","SH = Ai @ Ai.T\n","nsym_arr = Ai.sum(1)\n","sim_rows = []\n","for i in range(len(dis_names)):\n","    for j in range(i + 1, len(dis_names)):\n","        sh = int(SH[i, j])\n","        if sh >= CFG[\"SIM_MIN_SHARED\"]:\n","            sim_rows.append(dict(a=dis_names[i], b=dis_names[j], shared=sh,\n","                                 jaccard=round(sh / float(nsym_arr[i] + nsym_arr[j] - sh), 4)))\n","\n","print(f\"Disease nodes {len(disease_rows)} | Symptom nodes {len(symptom_rows)} | HAS_SYMPTOM {len(has_rows)} | SIMILAR_TO {len(sim_rows)}\")\n","print(\"symptoms per disease:\", pd.Series(nsym_arr).describe()[[\"min\", \"50%\", \"max\"]].to_dict())\n","print(\"prevalence range of existing edges:\", round(prev.values[A_sym].min(), 3), \"-\", round(prev.values[A_sym].max(), 3))\n","T_BUILD_TABLES = time.perf_counter() - t_build0"]},{"cell_type":"markdown","id":"5df0374b","metadata":{"papermill":{"duration":0.005274,"end_time":"2026-11-23T10:12:27.825094+00:00","exception":false,"start_time":"2026-11-23T10:12:27.81982+00:00","status":"completed"},"tags":[]},"source":["## 3. Benchmark (Task 6) — gold answers computed from the data with pandas/numpy\n","\n","Gold answers are computed **directly from the incidence matrix**, independently of Neo4j and of any LLM, then saved to `benchmark.csv`.\n","40 questions = 8 pe